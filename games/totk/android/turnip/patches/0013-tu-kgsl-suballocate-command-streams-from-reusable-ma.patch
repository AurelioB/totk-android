diff --git a/src/freedreno/vulkan/tests/cs_fake_bo.cc b/src/freedreno/vulkan/tests/cs_fake_bo.cc
new file mode 100644
index 00000000000..cbdafead0b5
--- /dev/null
+++ b/src/freedreno/vulkan/tests/cs_fake_bo.cc
@@ -0,0 +1,192 @@
+/* SPDX-License-Identifier: MIT */
+#include "cs_fake_bo.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <unordered_map>
+#include <sys/mman.h>
+#include <unistd.h>
+
+/* Production tu_cs_pool uses this device-wide page-size value. */
+uint64_t os_page_size;
+
+namespace cs_test {
+namespace {
+struct bo_record {
+   enum tu_bo_alloc_flags flags;
+   void *mapping;
+   size_t mapping_size;
+};
+
+std::mutex backend_mutex;
+std::unordered_map<const struct tu_bo *, bo_record> live_bos;
+bo_counters totals;
+uint64_t next_iova;
+uint32_t next_handle;
+bool allocation_failure;
+bool map_failure;
+}
+
+[[noreturn]] void
+fail(const char *expression, const char *file, int line)
+{
+   fprintf(stderr, "%s:%d: CHECK(%s) failed\n", file, line, expression);
+   abort();
+}
+
+void
+reset_backend()
+{
+   std::lock_guard<std::mutex> lock(backend_mutex);
+   CHECK(live_bos.empty());
+   os_page_size = sysconf(_SC_PAGESIZE);
+   CHECK(os_page_size != 0 && (os_page_size & (os_page_size - 1)) == 0);
+   totals = {};
+   next_iova = 0x100000000ull;
+   next_handle = 1;
+   allocation_failure = map_failure = false;
+}
+
+bo_counters
+counters()
+{
+   std::lock_guard<std::mutex> lock(backend_mutex);
+   return totals;
+}
+
+enum tu_bo_alloc_flags
+flags(const struct tu_bo *bo)
+{
+   std::lock_guard<std::mutex> lock(backend_mutex);
+   CHECK(live_bos.count(bo));
+   return live_bos.at(bo).flags;
+}
+
+bool
+is_live(const struct tu_bo *bo)
+{
+   std::lock_guard<std::mutex> lock(backend_mutex);
+   return live_bos.count(bo);
+}
+
+void
+fail_next_allocation()
+{
+   std::lock_guard<std::mutex> lock(backend_mutex);
+   CHECK(!allocation_failure);
+   allocation_failure = true;
+}
+
+void
+fail_next_map()
+{
+   std::lock_guard<std::mutex> lock(backend_mutex);
+   CHECK(!map_failure);
+   map_failure = true;
+}
+} /* namespace cs_test */
+
+VkResult
+tu_bo_init_new_explicit_iova(struct tu_device *dev,
+                             struct vk_object_base *base,
+                             struct tu_bo **out_bo, uint64_t size,
+                             uint64_t alignment, uint64_t client_iova,
+                             VkMemoryPropertyFlags memory_properties,
+                             enum tu_bo_alloc_flags flags,
+                             struct tu_sparse_vma *lazy_vma, const char *name)
+{
+   (void)dev;
+   (void)memory_properties;
+   CHECK(size && !client_iova && !lazy_vma);
+   std::lock_guard<std::mutex> lock(cs_test::backend_mutex);
+   if (cs_test::allocation_failure) {
+      cs_test::allocation_failure = false;
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   struct tu_bo *bo = static_cast<struct tu_bo *>(calloc(1, sizeof(*bo)));
+   CHECK(bo);
+   const uint64_t page = os_page_size;
+   bo->size = (size + page - 1) & ~(page - 1);
+   const uint64_t va_alignment = alignment > page ? alignment : page;
+   CHECK((va_alignment & (va_alignment - 1)) == 0);
+   cs_test::next_iova = (cs_test::next_iova + va_alignment - 1) & ~(va_alignment - 1);
+   /* Deliberately use addresses above 4GiB, exercising both IB address words. */
+   bo->iova = cs_test::next_iova;
+   CHECK((bo->iova >> 32) == ((bo->iova + bo->size - 1) >> 32));
+   cs_test::next_iova += bo->size + page;
+   bo->gem_handle = cs_test::next_handle++;
+   bo->refcnt = 1;
+   bo->base = base;
+   bo->name = name;
+   cs_test::live_bos.emplace(bo, cs_test::bo_record{flags, nullptr, 0});
+   ++cs_test::totals.allocations;
+   ++cs_test::totals.live;
+   cs_test::totals.live_bytes += bo->size;
+   *out_bo = bo;
+   return VK_SUCCESS;
+}
+
+VkResult
+tu_bo_map(struct tu_device *dev, struct tu_bo *bo, void *placed_addr)
+{
+   (void)dev;
+   CHECK(!placed_addr);
+   std::lock_guard<std::mutex> lock(cs_test::backend_mutex);
+   CHECK(cs_test::live_bos.count(bo));
+   if (bo->map)
+      return VK_SUCCESS;
+   if (cs_test::map_failure) {
+      cs_test::map_failure = false;
+      return VK_ERROR_MEMORY_MAP_FAILED;
+   }
+
+   auto &record = cs_test::live_bos.at(bo);
+   /* Guard pages catch whole-parent overruns. Neighbor sentinels in the tests
+    * catch the more subtle within-parent slice overruns.
+    */
+   record.mapping_size = bo->size + 2 * os_page_size;
+   record.mapping = mmap(nullptr, record.mapping_size, PROT_NONE,
+                         MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+   CHECK(record.mapping != MAP_FAILED);
+   bo->map = static_cast<char *>(record.mapping) + os_page_size;
+   CHECK(mprotect(bo->map, bo->size, PROT_READ | PROT_WRITE) == 0);
+   ++cs_test::totals.maps;
+   return VK_SUCCESS;
+}
+
+VkResult
+tu_bo_unmap(struct tu_device *dev, struct tu_bo *bo, bool reserve)
+{
+   (void)dev;
+   CHECK(!reserve);
+   std::lock_guard<std::mutex> lock(cs_test::backend_mutex);
+   CHECK(cs_test::live_bos.count(bo));
+   auto &record = cs_test::live_bos.at(bo);
+   if (bo->map) {
+      CHECK(munmap(record.mapping, record.mapping_size) == 0);
+      bo->map = nullptr;
+      record.mapping = nullptr;
+      record.mapping_size = 0;
+      ++cs_test::totals.unmaps;
+   }
+   return VK_SUCCESS;
+}
+
+void
+tu_bo_finish(struct tu_device *dev, struct tu_bo *bo)
+{
+   CHECK(cs_test::is_live(bo));
+   CHECK(p_atomic_read(&bo->refcnt) > 0);
+   if (!p_atomic_dec_zero(&bo->refcnt))
+      return;
+
+   CHECK(tu_bo_unmap(dev, bo, false) == VK_SUCCESS);
+   std::lock_guard<std::mutex> lock(cs_test::backend_mutex);
+   CHECK(cs_test::live_bos.erase(bo) == 1);
+   ++cs_test::totals.destroys;
+   --cs_test::totals.live;
+   cs_test::totals.live_bytes -= bo->size;
+   free(bo);
+}
diff --git a/src/freedreno/vulkan/tests/cs_fake_bo.h b/src/freedreno/vulkan/tests/cs_fake_bo.h
new file mode 100644
index 00000000000..77aa1d72e5c
--- /dev/null
+++ b/src/freedreno/vulkan/tests/cs_fake_bo.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef TU_CS_FAKE_BO_H
+#define TU_CS_FAKE_BO_H
+
+#include "tu_knl.h"
+
+#include <cstddef>
+#include <cstdint>
+
+/* Only the kernel/BO boundary is replaced. Allocator, CS, suballocator and RMV
+ * implementation code are compiled from the driver sources by meson.build.
+ */
+namespace cs_test {
+
+[[noreturn]] void fail(const char *expression, const char *file, int line);
+
+#define CHECK(expression) do { \
+   if (!(expression)) \
+      cs_test::fail(#expression, __FILE__, __LINE__); \
+} while (0)
+
+struct bo_counters {
+   uint64_t allocations;
+   uint64_t maps;
+   uint64_t unmaps;
+   uint64_t destroys;
+   uint64_t live;
+   uint64_t live_bytes;
+};
+
+void reset_backend();
+bo_counters counters();
+enum tu_bo_alloc_flags flags(const struct tu_bo *bo);
+bool is_live(const struct tu_bo *bo);
+void fail_next_allocation();
+void fail_next_map();
+
+} /* namespace cs_test */
+#endif
diff --git a/src/freedreno/vulkan/tests/cs_slabs.cc b/src/freedreno/vulkan/tests/cs_slabs.cc
new file mode 100644
index 00000000000..f658c34b533
--- /dev/null
+++ b/src/freedreno/vulkan/tests/cs_slabs.cc
@@ -0,0 +1,751 @@
+/* SPDX-License-Identifier: MIT */
+#include "cs_fake_bo.h"
+#include "tu_cs.h"
+#include "tu_cs_pool.h"
+#include "tu_device.h"
+#include "tu_rmv.h"
+#include "tu_suballoc.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <thread>
+#include <vector>
+
+/* A fixture-owned setting, not a replacement for any allocator/CS logic. */
+struct tu_env tu_env;
+
+namespace {
+using cs_test::counters;
+constexpr uint32_t page = TU_CS_POOL_PAGE_SIZE;
+constexpr uint32_t slab_size = TU_CS_SLAB_SIZE;
+bool bos_enabled;
+
+struct fixture {
+   std::unique_ptr<tu_device> dev{new tu_device{}};
+
+   explicit fixture(bool pooled = true)
+   {
+      cs_test::reset_backend();
+      dev->vk.alloc = *vk_default_allocator();
+      struct vk_rmv_device_info info = {};
+      vk_memory_trace_init(&dev->vk, &info);
+      if (pooled) {
+         CHECK(tu_cs_pool_init(dev.get()) == VK_SUCCESS);
+         CHECK(dev->cs_pool);
+      }
+   }
+
+   ~fixture()
+   {
+      tu_cs_pool_finish(dev.get());
+      CHECK(!dev->cs_pool);
+      const auto totals = counters();
+      CHECK(totals.live == 0 && totals.live_bytes == 0);
+      CHECK(totals.allocations == totals.destroys);
+      CHECK(totals.maps == totals.unmaps);
+
+      /* Real RMV tokens: one command-allocator resource per parent lifetime,
+       * never one per slice, and every created resource destroyed exactly once.
+       */
+      std::set<uint32_t> live_resources;
+      uint64_t creates = 0, destroys = 0;
+      util_dynarray_foreach(&dev->vk.memory_trace_data.tokens,
+                           struct vk_rmv_token, token) {
+         if (token->type == VK_RMV_TOKEN_TYPE_RESOURCE_CREATE) {
+            CHECK(token->data.resource_create.type == VK_RMV_RESOURCE_TYPE_COMMAND_ALLOCATOR);
+            CHECK(live_resources.insert(token->data.resource_create.resource_id).second);
+            ++creates;
+         } else if (token->type == VK_RMV_TOKEN_TYPE_RESOURCE_DESTROY) {
+            CHECK(live_resources.erase(token->data.resource_destroy.resource_id) == 1);
+            ++destroys;
+         }
+      }
+      CHECK(live_resources.empty() && creates == destroys);
+      CHECK(creates <= totals.maps);
+      CHECK(_mesa_hash_table_num_entries(&dev->vk.memory_trace_data.handle_table->table) == 0);
+      vk_memory_trace_finish(&dev->vk);
+      simple_mtx_destroy(&dev->vk.memory_trace_data.token_mtx);
+   }
+};
+
+uint32_t *
+map(const struct tu_cs_allocation &allocation)
+{
+   return reinterpret_cast<uint32_t *>(static_cast<char *>(allocation.bo->map) + allocation.offset);
+}
+
+void
+fill(const struct tu_cs_allocation &allocation, uint32_t value)
+{
+   CHECK(allocation.size % 4 == 0);
+   std::fill_n(map(allocation), allocation.size / 4, value);
+}
+
+void
+check_fill(const struct tu_cs_allocation &allocation, uint32_t value)
+{
+   CHECK(cs_test::is_live(allocation.bo));
+   for (uint32_t i = 0; i < allocation.size / 4; ++i)
+      CHECK(map(allocation)[i] == value);
+}
+
+void
+check_allocation(const struct tu_cs_allocation &allocation, uint32_t size,
+                 bool writeable, bool pooled = true)
+{
+   CHECK(allocation.bo && allocation.bo->map && cs_test::is_live(allocation.bo));
+   CHECK(allocation.size == size);
+   CHECK(uint64_t(allocation.offset) + size <= allocation.bo->size);
+   CHECK((cs_test::flags(allocation.bo) & TU_BO_ALLOC_GPU_READ_ONLY) ==
+         (writeable ? 0 : TU_BO_ALLOC_GPU_READ_ONLY));
+   CHECK(cs_test::flags(allocation.bo) & TU_BO_ALLOC_ALLOW_DUMP);
+   CHECK(cs_test::flags(allocation.bo) & TU_BO_ALLOC_NO_32B_ROLLOVER);
+   CHECK(bool(allocation.slab) == (pooled && size <= slab_size));
+   if (allocation.slab) {
+      CHECK(allocation.offset % page == 0);
+      CHECK(allocation.bo->size == slab_size);
+   } else {
+      CHECK(allocation.offset == 0);
+   }
+}
+
+bool
+nonoverlap(const struct tu_cs_allocation &a, const struct tu_cs_allocation &b)
+{
+   if (a.bo != b.bo)
+      return true;
+   const uint64_t a_end = a.offset + ((uint64_t(a.size) + page - 1) / page) * page;
+   const uint64_t b_end = b.offset + ((uint64_t(b.size) + page - 1) / page) * page;
+   return a_end <= b.offset || b_end <= a.offset;
+}
+
+const struct tu_cs_allocation &
+last(const struct tu_cs_allocation_array &array)
+{
+   CHECK(array.count);
+   return array.allocations[array.count - 1];
+}
+
+void
+check_same(const struct tu_cs_allocation &a, const struct tu_cs_allocation &b)
+{
+   CHECK(a.bo == b.bo && a.slab == b.slab && a.offset == b.offset && a.size == b.size);
+}
+
+void
+check_entry(const struct tu_cs_entry &entry, const struct tu_cs &owner)
+{
+   CHECK(entry.bo && entry.size && cs_test::is_live(entry.bo));
+   bool contained = false;
+   for (const auto *array : {&owner.read_only, &owner.read_write}) {
+      for (uint32_t i = 0; i < array->count; ++i) {
+         const auto &allocation = array->allocations[i];
+         if (entry.bo == allocation.bo && entry.offset >= allocation.offset &&
+             uint64_t(entry.offset) + entry.size <= uint64_t(allocation.offset) + allocation.size)
+            contained = true;
+      }
+   }
+   CHECK(contained);
+}
+
+void
+emit(struct tu_cs *cs, uint32_t count, uint32_t value)
+{
+   CHECK(tu_cs_reserve_space(cs, count) == VK_SUCCESS);
+   for (uint32_t i = 0; i < count; ++i)
+      tu_cs_emit(cs, value);
+}
+
+void
+test_page_reuse_and_nonoverlap()
+{
+   fixture f;
+   constexpr unsigned count = slab_size / page;
+   std::vector<struct tu_cs_allocation> allocations(count);
+   std::set<uint32_t> released;
+   for (unsigned i = 0; i < count; ++i) {
+      /* Odd sizes exercise requested bytes versus page reservation. */
+      CHECK(tu_cs_pool_alloc(f.dev.get(), page - 4, false, "reuse cs", &allocations[i]) == VK_SUCCESS);
+      check_allocation(allocations[i], page - 4, false);
+      for (unsigned j = 0; j < i; ++j)
+         CHECK(nonoverlap(allocations[i], allocations[j]));
+      fill(allocations[i], i + 1);
+   }
+   CHECK(counters().maps == 1);
+   struct tu_bo *parent = allocations[0].bo;
+   for (unsigned i = 0; i < count; i += 2) {
+      released.insert(allocations[i].offset);
+      tu_cs_pool_free(f.dev.get(), &allocations[i]);
+      CHECK(!allocations[i].bo);
+   }
+   for (unsigned i = 0; i < count; i += 2) {
+      CHECK(tu_cs_pool_alloc(f.dev.get(), page - 4, false, "reuse cs", &allocations[i]) == VK_SUCCESS);
+      CHECK(allocations[i].bo == parent);
+      CHECK(released.erase(allocations[i].offset) == 1);
+      fill(allocations[i], i + 1);
+   }
+   CHECK(released.empty() && counters().maps == 1);
+   for (unsigned i = 0; i < count; ++i) {
+      check_fill(allocations[i], i + 1);
+      tu_cs_pool_free(f.dev.get(), &allocations[i]);
+   }
+   CHECK(counters().live == 1); /* one bounded empty RO slab */
+}
+
+void
+test_mixed_ranges_and_permissions()
+{
+   fixture f;
+   std::vector<struct tu_cs_allocation> allocations(180);
+   for (unsigned i = 0; i < allocations.size(); ++i) {
+      const uint32_t size = ((i * 17) % 23 + 1) * page - 4;
+      CHECK(tu_cs_pool_alloc(f.dev.get(), size, i & 1, "mixed cs", &allocations[i]) == VK_SUCCESS);
+      check_allocation(allocations[i], size, i & 1);
+      for (unsigned j = 0; j < i; ++j) {
+         CHECK(nonoverlap(allocations[i], allocations[j]));
+         if ((i & 1) != (j & 1))
+            CHECK(allocations[i].bo != allocations[j].bo);
+      }
+      fill(allocations[i], 0xab000000u + i);
+   }
+   /* Interleaved releases, not a stack or a linear allocator's single spare. */
+   for (unsigned phase = 0; phase < 3; ++phase) {
+      for (unsigned i = phase; i < allocations.size(); i += 3) {
+         check_fill(allocations[i], 0xab000000u + i);
+         tu_cs_pool_free(f.dev.get(), &allocations[i]);
+      }
+   }
+   CHECK(counters().live == 2); /* at most one empty slab in each permission pool */
+   CHECK(counters().live_bytes == 2 * slab_size);
+}
+
+void
+test_warm_recorder_shape()
+{
+   fixture f;
+   /* 4,608 live owners with both warm streams, matching the chunk-600-scale
+    * recorder high water. This is a host storage invariant, not a frame replay.
+    */
+   constexpr unsigned owners = 4608;
+   std::vector<struct tu_cs> draws(owners), states(owners);
+   for (unsigned i = 0; i < owners; ++i) {
+      tu_cs_init(&draws[i], f.dev.get(), TU_CS_MODE_GROW, 4096, "draw cs");
+      tu_cs_begin(&draws[i]);
+      emit(&draws[i], 1, 0xc5000000u + i);
+      tu_cs_end(&draws[i]);
+      tu_cs_init(&states[i], f.dev.get(), TU_CS_MODE_SUB_STREAM, 2048, "draw sub cs");
+      struct tu_cs_memory memory;
+      CHECK(tu_cs_alloc(&states[i], 1, 4, &memory) == VK_SUCCESS);
+      std::fill_n(memory.map, 4, i);
+   }
+   const auto warm = counters();
+   CHECK(warm.maps == (uint64_t(owners) * (16384 + 8192) + slab_size - 1) / slab_size);
+   CHECK(warm.maps * 100 < 2 * owners);
+   tu_cs_pool_dump_stats(f.dev.get());
+   for (unsigned i = 0; i < owners; ++i) {
+      check_entry(draws[i].entries[0], draws[i]);
+      CHECK(*reinterpret_cast<uint32_t *>(static_cast<char *>(draws[i].entries[0].bo->map) +
+                                         draws[i].entries[0].offset) == 0xc5000000u + i);
+      tu_cs_reset(&draws[i]);
+      tu_cs_reset(&states[i]);
+      tu_cs_begin(&draws[i]);
+      emit(&draws[i], 1, i);
+      tu_cs_end(&draws[i]);
+      struct tu_cs_memory memory;
+      CHECK(tu_cs_alloc(&states[i], 1, 4, &memory) == VK_SUCCESS);
+      std::fill_n(memory.map, 4, ~i);
+   }
+   CHECK(counters().maps == warm.maps);
+   for (unsigned i = 0; i < owners; ++i) {
+      tu_cs_finish(&draws[i]);
+      tu_cs_finish(&states[i]);
+   }
+   CHECK(counters().live == 1);
+}
