+void
+test_conditional_growth_and_request_bounds()
+{
+   fixture f;
+   struct tu_cs_allocation before, after;
+   CHECK(tu_cs_pool_alloc(f.dev.get(), page, false, "conditional neighbor", &before) == VK_SUCCESS);
+   fill(before, 0x13572468);
+   struct tu_cs cs;
+   tu_cs_init(&cs, f.dev.get(), TU_CS_MODE_GROW, 16, "conditional cs");
+   tu_cs_begin(&cs);
+   tu_cond_exec_start(&cs, CP_COND_EXEC_0_RENDER_MODE_GMEM);
+   tu_cond_exec_start(&cs, CP_COND_EXEC_0_RENDER_MODE_SYSMEM);
+   uint32_t *old_outer = cs.cond_dwords[0];
+   uint32_t *old_inner = cs.cond_dwords[1];
+   CHECK(tu_cs_pool_alloc(f.dev.get(), page, false, "conditional neighbor", &after) == VK_SUCCESS);
+   fill(after, 0x24681357);
+   emit(&cs, tu_cs_get_space(&cs), 0xaaaa0000);
+   const uint32_t outer_length = cs.cur - old_outer - 1;
+   const uint32_t inner_length = cs.cur - old_inner - 1;
+   emit(&cs, 32, 0xbbbb0000);
+   CHECK(cs.read_only.count == 2);
+   CHECK(*old_outer == outer_length && *old_inner == inner_length);
+   const auto &allocation = last(cs.read_only);
+   CHECK(cs.end == map(allocation) + allocation.size / 4);
+   CHECK(cs.cur <= cs.reserved_end && cs.reserved_end <= cs.end);
+   uint32_t *new_outer = cs.cond_dwords[0];
+   uint32_t *new_inner = cs.cond_dwords[1];
+   tu_cond_exec_end(&cs);
+   tu_cond_exec_end(&cs);
+   CHECK(*new_inner == 32 && *new_outer == 35);
+   tu_cs_end(&cs);
+   CHECK(cs.entry_count == 2);
+   for (unsigned i = 0; i < cs.entry_count; ++i)
+      check_entry(cs.entries[i], cs);
+   check_fill(before, 0x13572468);
+   check_fill(after, 0x24681357);
+   tu_cs_finish(&cs);
+   tu_cs_pool_free(f.dev.get(), &before);
+   tu_cs_pool_free(f.dev.get(), &after);
+
+   struct tu_cs suballoc, sub;
+   tu_cs_init(&suballoc, f.dev.get(), TU_CS_MODE_SUB_STREAM, 16, "overflow request cs");
+   const auto maps = counters().maps;
+   struct tu_cs_memory memory;
+   CHECK(tu_cs_alloc(&suballoc, UINT32_MAX, 1024, &memory) == VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   CHECK(counters().maps == maps && !suballoc.read_only.count);
+   tu_cs_reset(&suballoc);
+   CHECK(tu_cs_begin_sub_stream_aligned(&suballoc, UINT32_MAX, 3, &sub) ==
+         VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   CHECK(!tu_cs_end_sub_stream(&suballoc, &sub).bo);
+   tu_cs_finish(&sub);
+   tu_cs_finish(&suballoc);
+}
