+void
+test_concurrent_alloc_free()
+{
+   fixture f;
+   std::mutex live_mutex;
+   std::vector<struct tu_cs_allocation> live;
+   std::atomic<unsigned> ready{0};
+   std::atomic<bool> go{false};
+   std::vector<std::thread> threads;
+   constexpr unsigned thread_count = 8, rounds = 1200;
+   for (unsigned thread = 0; thread < thread_count; ++thread) {
+      threads.emplace_back([&, thread] {
+         ready.fetch_add(1, std::memory_order_release);
+         while (!go.load(std::memory_order_acquire))
+            std::this_thread::yield();
+         for (unsigned round = 0; round < rounds; ++round) {
+            struct tu_cs_allocation allocation;
+            const bool writeable = (thread + round) & 1;
+            const uint32_t size = ((round * 13 + thread) % 7 + 1) * page - 4;
+            CHECK(tu_cs_pool_alloc(f.dev.get(), size, writeable, "thread cs", &allocation) == VK_SUCCESS);
+            {
+               std::lock_guard<std::mutex> lock(live_mutex);
+               for (const auto &other : live)
+                  CHECK(nonoverlap(allocation, other));
+               live.push_back(allocation);
+            }
+            const uint32_t sentinel = 0x80000000u | (thread << 20) | round;
+            fill(allocation, sentinel);
+            if ((round & 7) == 0)
+               std::this_thread::yield();
+            check_fill(allocation, sentinel);
+            {
+               std::lock_guard<std::mutex> lock(live_mutex);
+               auto it = std::find_if(live.begin(), live.end(), [&](const auto &other) {
+                  return other.bo == allocation.bo && other.offset == allocation.offset;
+               });
+               CHECK(it != live.end());
+               live.erase(it);
+            }
+            tu_cs_pool_free(f.dev.get(), &allocation);
+         }
+      });
+   }
+   while (ready.load(std::memory_order_acquire) != thread_count)
+      std::this_thread::yield();
+   go.store(true, std::memory_order_release);
+   for (auto &thread : threads)
+      thread.join();
+   CHECK(live.empty());
+   CHECK(counters().live <= 2 && counters().live_bytes <= 2 * slab_size);
+   tu_cs_pool_dump_stats(f.dev.get());
+}
