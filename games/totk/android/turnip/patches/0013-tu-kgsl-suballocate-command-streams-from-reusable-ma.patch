+
+struct tu_cs_slab {
+   struct list_head link;
+   struct tu_bo *bo;
+   bool writeable;
+   uint32_t free_pages;
+   BITSET_DECLARE(used, TU_CS_SLAB_PAGES);
+
+   /* Only slice heads are populated, and only with TU_DEBUG=bos.  Names are
+    * interned once per distinct stream name, not allocated for each slice.
+    */
+   struct tu_cs_name_stats *names[TU_CS_SLAB_PAGES];
+};
+
+struct tu_cs_pool {
+   /* Lock order is pool -> device BO/statistics locks.  No emission takes it. */
+   mtx_t mutex;
+   struct list_head slabs[2];
+   struct tu_cs_slab *empty[2];
+   struct list_head names;
+   uint64_t slab_count[2];
+   uint64_t slab_bytes;
+   uint64_t slices;
+   uint64_t bytes;
+   uint64_t pages;
+   uint64_t dedicated;
+   uint64_t dedicated_bytes;
+};
+
+static VkResult
+create_bo(struct tu_device *dev, uint32_t size, bool writeable,
+          const char *name, struct tu_bo **out)
+{
+   VkResult result = tu_bo_init_new(
+      dev, NULL, out, size,
+      static_cast<enum tu_bo_alloc_flags>(
+         COND(!writeable, TU_BO_ALLOC_GPU_READ_ONLY) |
+         TU_BO_ALLOC_ALLOW_DUMP | tu_bo_ib_flags(dev)),
+      name);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = tu_bo_map(dev, *out, NULL);
+   if (result != VK_SUCCESS) {
+      tu_bo_finish(dev, *out);
+      *out = NULL;
+      return result;
+   }
+
+   /* Resource identity belongs to the parent, never to individual slices. */
+   TU_RMV(cmd_buffer_bo_create, dev, *out);
+   return VK_SUCCESS;
+}
+
+static void
+destroy_slab(struct tu_device *dev, struct tu_cs_slab *slab)
+{
+   assert(slab->free_pages == TU_CS_SLAB_PAGES);
+   struct tu_cs_pool *pool = dev->cs_pool;
+   pool->slab_count[slab->writeable]--;
+   pool->slab_bytes -= slab->bo->size;
+   list_del(&slab->link);
+   TU_RMV(resource_destroy, dev, slab->bo);
+   tu_bo_finish(dev, slab->bo);
+   vk_free(&dev->vk.alloc, slab);
+}
+
+VkResult
+tu_cs_pool_init(struct tu_device *dev)
+{
+   assert(!dev->cs_pool);
+   struct tu_cs_pool *pool = static_cast<struct tu_cs_pool *>(
+      vk_zalloc(&dev->vk.alloc, sizeof(*pool), 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE));
+   if (!pool)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   if (mtx_init(&pool->mutex, mtx_plain) != thrd_success) {
+      vk_free(&dev->vk.alloc, pool);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   list_inithead(&pool->slabs[0]);
+   list_inithead(&pool->slabs[1]);
+   list_inithead(&pool->names);
+   dev->cs_pool = pool;
+   return VK_SUCCESS;
+}
+
+static struct tu_cs_name_stats *
+get_name_stats(struct tu_device *dev, const char *name)
+{
+   if (likely(!TU_DEBUG(BOS)))
+      return NULL;
+
+   struct tu_cs_pool *pool = dev->cs_pool;
+   name = name ? name : "(unnamed)";
+   list_for_each_entry(struct tu_cs_name_stats, stats, &pool->names, link) {
+      if (!strcmp(stats->name, name))
+         return stats;
+   }
+
+   size_t len = strlen(name) + 1;
+   struct tu_cs_name_stats *stats = static_cast<struct tu_cs_name_stats *>(
+      vk_zalloc(&dev->vk.alloc, sizeof(*stats) + len, 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE));
+   if (!stats)
+      return NULL;
+   memcpy(stats->name, name, len);
+   list_addtail(&stats->link, &pool->names);
+   return stats;
+}
+
+static bool
+find_pages(const struct tu_cs_slab *slab, uint32_t pages, uint32_t *first)
+{
+   if (slab->free_pages < pages)
+      return false;
+
+   uint32_t run = 0;
+   for (uint32_t i = 0; i < TU_CS_SLAB_PAGES; i++) {
+      run = BITSET_TEST(slab->used, i) ? 0 : run + 1;
+      if (run == pages) {
+         *first = i + 1 - pages;
+         return true;
+      }
+   }
+   return false;
+}
+
+VkResult
+tu_cs_pool_alloc(struct tu_device *dev, uint32_t size, bool writeable,
+                 const char *name, struct tu_cs_allocation *out)
+{
+   *out = (struct tu_cs_allocation) {};
+   assert(size);
+   struct tu_cs_pool *pool = dev->cs_pool;
+   if (!pool || size > TU_CS_SLAB_SIZE) {
+      /* Disabled pooling preserves the original BO size, flags and name. */
+      if (pool)
+         mtx_lock(&pool->mutex);
+      VkResult result = create_bo(dev, size, writeable, name, &out->bo);
+      if (result == VK_SUCCESS) {
+         out->size = size;
+         if (pool) {
+            pool->dedicated++;
+            pool->dedicated_bytes += out->bo->size;
+         }
+      }
+      if (pool)
+         mtx_unlock(&pool->mutex);
+      return result;
+   }
+
+   const uint32_t pages = DIV_ROUND_UP(size, TU_CS_POOL_PAGE_SIZE);
+   mtx_lock(&pool->mutex);
+
+   struct tu_cs_slab *slab = NULL;
+   uint32_t first = 0;
+   list_for_each_entry(struct tu_cs_slab, candidate, &pool->slabs[writeable], link) {
+      if (find_pages(candidate, pages, &first)) {
+         slab = candidate;
+         break;
+      }
+   }
+
+   if (!slab) {
+      slab = static_cast<struct tu_cs_slab *>(
+         vk_zalloc(&dev->vk.alloc, sizeof(*slab), 8,
+                   VK_SYSTEM_ALLOCATION_SCOPE_DEVICE));
+      if (!slab) {
+         mtx_unlock(&pool->mutex);
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+      }
+
+      VkResult result = create_bo(dev, TU_CS_SLAB_SIZE, writeable,
+                                  writeable ? "cs slab rw" : "cs slab ro",
+                                  &slab->bo);
+      if (result != VK_SUCCESS) {
+         vk_free(&dev->vk.alloc, slab);
+         mtx_unlock(&pool->mutex);
+         return result;
+      }
+      slab->writeable = writeable;
+      slab->free_pages = TU_CS_SLAB_PAGES;
+      list_addtail(&slab->link, &pool->slabs[writeable]);
+      pool->slab_count[writeable]++;
+      pool->slab_bytes += slab->bo->size;
+   }
+
+   if (pool->empty[writeable] == slab)
+      pool->empty[writeable] = NULL;
+   BITSET_SET_RANGE(slab->used, first, first + pages - 1);
+   slab->free_pages -= pages;
+   pool->slices++;
+   pool->bytes += size;
+   pool->pages += pages;
+
+   struct tu_cs_name_stats *stats = get_name_stats(dev, name);
+   slab->names[first] = stats;
+   if (stats) {
+      stats->slices++;
+      stats->bytes += size;
+      stats->pages += pages;
+   }
+
+   *out = (struct tu_cs_allocation) {
+      .bo = tu_bo_get_ref(slab->bo),
+      .slab = slab,
+      .offset = first * TU_CS_POOL_PAGE_SIZE,
+      .size = size,
+   };
+   mtx_unlock(&pool->mutex);
+   return VK_SUCCESS;
+}
+
+void
+tu_cs_pool_free(struct tu_device *dev, struct tu_cs_allocation *allocation)
+{
+   if (!allocation->bo)
+      return;
+
+   struct tu_cs_pool *pool = dev->cs_pool;
+   if (!allocation->slab) {
+      if (pool) {
+         mtx_lock(&pool->mutex);
+         assert(pool->dedicated);
+         pool->dedicated--;
+         pool->dedicated_bytes -= allocation->bo->size;
+      }
+      TU_RMV(resource_destroy, dev, allocation->bo);
+      tu_bo_finish(dev, allocation->bo);
+      if (pool)
+         mtx_unlock(&pool->mutex);
+   } else {
+      assert(pool);
+      struct tu_cs_slab *slab = allocation->slab;
+      uint32_t first = allocation->offset / TU_CS_POOL_PAGE_SIZE;
+      uint32_t pages = DIV_ROUND_UP(allocation->size, TU_CS_POOL_PAGE_SIZE);
+      assert(allocation->bo == slab->bo);
+      assert(allocation->offset % TU_CS_POOL_PAGE_SIZE == 0);
+      assert(first + pages <= TU_CS_SLAB_PAGES);
+      mtx_lock(&pool->mutex);
+      assert(BITSET_TEST_RANGE(slab->used, first, first + pages - 1));
+      BITSET_CLEAR_RANGE(slab->used, first, first + pages - 1);
+      slab->free_pages += pages;
+      pool->slices--;
+      pool->bytes -= allocation->size;
+      pool->pages -= pages;
+
+      struct tu_cs_name_stats *stats = slab->names[first];
+      slab->names[first] = NULL;
+      if (stats) {
+         stats->slices--;
+         stats->bytes -= allocation->size;
+         stats->pages -= pages;
+      }
+
+      /* Drop the slice's reference before considering the pool's cached one. */
+      tu_bo_finish(dev, allocation->bo);
+      if (slab->free_pages == TU_CS_SLAB_PAGES) {
+         if (pool->empty[slab->writeable])
+            destroy_slab(dev, slab);
+         else
+            pool->empty[slab->writeable] = slab;
+      }
+      mtx_unlock(&pool->mutex);
+   }
+   *allocation = (struct tu_cs_allocation) {};
+}
+
+void
+tu_cs_pool_dump_stats(struct tu_device *dev)
+{
+   struct tu_cs_pool *pool = dev->cs_pool;
+   if (!pool || likely(!TU_DEBUG(BOS)))
+      return;
+
+   mtx_lock(&pool->mutex);
+   mesa_logi("cs pool: %llu live slices, %llu ro/%llu rw parent slabs, "
+             "%llu dedicated, %llu requested bytes, %llu allocated pages "
+             "(%llu bytes), %llu parent mapped bytes, %llu dedicated mapped bytes",
+             (unsigned long long) pool->slices,
+             (unsigned long long) pool->slab_count[0],
+             (unsigned long long) pool->slab_count[1],
+             (unsigned long long) pool->dedicated,
+             (unsigned long long) pool->bytes,
+             (unsigned long long) pool->pages,
+             (unsigned long long) (pool->pages * TU_CS_POOL_PAGE_SIZE),
+             (unsigned long long) pool->slab_bytes,
+             (unsigned long long) pool->dedicated_bytes);
+   list_for_each_entry(struct tu_cs_name_stats, stats, &pool->names, link) {
+      if (stats->slices) {
+         mesa_logi("%30s: %llu cs slices, %llu requested bytes, "
+                   "%llu allocated pages (%llu bytes)",
+                   stats->name, (unsigned long long) stats->slices,
+                   (unsigned long long) stats->bytes,
+                   (unsigned long long) stats->pages,
+                   (unsigned long long) (stats->pages * TU_CS_POOL_PAGE_SIZE));
+      }
+   }
+   mtx_unlock(&pool->mutex);
+}
+
+void
+tu_cs_pool_finish(struct tu_device *dev)
+{
+   struct tu_cs_pool *pool = dev->cs_pool;
+   if (!pool)
+      return;
+
+   tu_cs_pool_dump_stats(dev);
+   assert(!pool->slices && !pool->dedicated);
+   for (unsigned i = 0; i < ARRAY_SIZE(pool->slabs); i++) {
+      list_for_each_entry_safe(struct tu_cs_slab, slab, &pool->slabs[i], link)
+         destroy_slab(dev, slab);
+   }
+   list_for_each_entry_safe(struct tu_cs_name_stats, stats, &pool->names, link) {
+      list_del(&stats->link);
+      vk_free(&dev->vk.alloc, stats);
+   }
+   mtx_destroy(&pool->mutex);
+   vk_free(&dev->vk.alloc, pool);
+   dev->cs_pool = NULL;
+}
diff --git a/src/freedreno/vulkan/tu_cs_pool.h b/src/freedreno/vulkan/tu_cs_pool.h
new file mode 100644
index 00000000000..11338a22439
--- /dev/null
+++ b/src/freedreno/vulkan/tu_cs_pool.h
@@ -0,0 +1,43 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef TU_CS_POOL_H
+#define TU_CS_POOL_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "vulkan/vulkan_core.h"
+
+struct tu_bo;
+struct tu_device;
+struct tu_cs_pool;
+struct tu_cs_slab;
+
+#define TU_CS_SLAB_SIZE (2u * 1024 * 1024)
+#define TU_CS_POOL_PAGE_SIZE 4096u
+
+/* An owning allocation, stored by value.  Entries borrow the parent BO and
+ * include offset in their BO-relative address.  size is the requested capacity
+ * in bytes; the pool privately rounds its reservation up to whole pages.
+ *
+ * A non-NULL slab owns both a bitmap reservation and a real parent BO reference.
+ * A NULL slab denotes a dedicated BO, including the disabled-pool path.
+ */
+struct tu_cs_allocation {
+   struct tu_bo *bo;
+   struct tu_cs_slab *slab;
+   uint32_t offset;
+   uint32_t size;
+};
+
+VkResult tu_cs_pool_init(struct tu_device *dev);
+/* All CS owners must have been finished before destroying the device pool. */
+void tu_cs_pool_finish(struct tu_device *dev);
+VkResult tu_cs_pool_alloc(struct tu_device *dev, uint32_t size, bool writeable,
+                          const char *name, struct tu_cs_allocation *out);
+void tu_cs_pool_free(struct tu_device *dev, struct tu_cs_allocation *allocation);
+/* Call before, never while, holding the device BO/statistics mutex. */
+void tu_cs_pool_dump_stats(struct tu_device *dev);
+
+#endif /* TU_CS_POOL_H */
