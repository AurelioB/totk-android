+   CHECK(tu_cs_get_cur_iova(&external) == 0x234567890ull + 128);
+   tu_cs_end(&external);
+   CHECK(!external.entry_count && !external.read_write.count);
+   tu_cs_reset(&external);
+   CHECK(external.cur == storage + 1 && external.end == storage + 33);
+   emit(&external, 32, 0x87654321);
+   tu_cs_finish(&external);
+   CHECK(storage[0] == 0x1234abcd && storage[33] == 0x1234abcd);
+   CHECK(counters().maps == 0);
+
+   struct tu_suballocator allocator;
+   tu_bo_suballocator_init(&allocator, f.dev.get(), 65536,
+                           TU_BO_ALLOC_GPU_READ_ONLY, "refcount test BO");
+   struct tu_suballoc_bo prefix, allocation;
+   CHECK(tu_suballoc_bo_alloc(&prefix, &allocator, page, page) == VK_SUCCESS);
+   CHECK(tu_suballoc_bo_alloc(&allocation, &allocator, page, page) == VK_SUCCESS);
+   CHECK(allocation.iova != allocation.bo->iova);
+   auto *base = static_cast<uint32_t *>(allocation.bo->map);
+   std::fill_n(base, page / 4, 0xabcdef01);
+   std::fill_n(base + 2 * page / 4, page / 4, 0xabcdef02);
+   struct tu_cs cs, sub;
+   const uint64_t initial_iova = allocation.iova;
+   tu_cs_init_suballoc(&cs, f.dev.get(), &allocation);
+   struct tu_bo *bo = allocation.bo;
+   CHECK(p_atomic_read(&bo->refcnt) == 4);
+   tu_suballoc_bo_free(&allocator, &prefix);
+   tu_suballoc_bo_free(&allocator, &allocation);
+   tu_bo_suballocator_finish(&allocator);
+   CHECK(p_atomic_read(&bo->refcnt) == 1);
+   CHECK(tu_cs_get_cur_iova(&cs) == initial_iova);
+   CHECK(tu_cs_begin_sub_stream_aligned(&cs, 2, 16, &sub) == VK_SUCCESS);
+   emit(&sub, 32, 0x31415926);
+   auto entry = tu_cs_end_sub_stream(&cs, &sub);
+   CHECK(entry.bo == bo && entry.offset == page && entry.size == 128);
+   tu_cs_reset(&cs);
+   CHECK(tu_cs_get_cur_iova(&cs) == initial_iova);
+   CHECK(cs.start == base + page / 4 && cs.end == base + 2 * page / 4);
+   struct tu_cs_memory memory;
+   CHECK(tu_cs_alloc(&cs, page / 4, 1, &memory) == VK_SUCCESS);
+   std::fill_n(memory.map, page / 4, 0x27182818);
+   for (unsigned i = 0; i < page / 4; ++i) {
+      CHECK(base[i] == 0xabcdef01);
+      CHECK(base[2 * page / 4 + i] == 0xabcdef02);
+   }
+   tu_cs_finish(&cs);
+   CHECK(counters().live == 0);
+}
