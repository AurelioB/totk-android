+void
+test_switch_overflow_and_reset(bool pooled)
+{
+   fixture f(pooled);
+   struct tu_cs_allocation neighbor;
+   CHECK(tu_cs_pool_alloc(f.dev.get(), page, false, "neighbor cs", &neighbor) == VK_SUCCESS);
+   fill(neighbor, 0xdeadbeef);
+   struct tu_cs cs;
+   tu_cs_init(&cs, f.dev.get(), TU_CS_MODE_GROW, 16, "switch cs");
+   tu_cs_begin(&cs);
+   emit(&cs, 3, 0x11111111);
+   const auto first_ro = last(cs.read_only);
+   if (pooled) {
+      CHECK(first_ro.bo == neighbor.bo && first_ro.offset != 0);
+   }
+   const uint64_t ro_cursor = tu_cs_get_cur_iova(&cs);
+   tu_cs_set_writeable(&cs, true);
+   emit(&cs, 5, 0x22222222);
+   CHECK(last(cs.read_write).bo != first_ro.bo);
+   const uint64_t rw_cursor = tu_cs_get_cur_iova(&cs);
+   tu_cs_set_writeable(&cs, false);
+   CHECK(tu_cs_get_cur_iova(&cs) == ro_cursor);
+   CHECK(cs.end == map(first_ro) + first_ro.size / 4);
+   emit(&cs, tu_cs_get_space(&cs), 0x33333333);
+   emit(&cs, 1, 0x44444444);
+   CHECK(cs.read_only.count == 2);
+   tu_cs_set_writeable(&cs, true);
+   CHECK(tu_cs_get_cur_iova(&cs) == rw_cursor);
+   const auto first_rw = last(cs.read_write);
+   CHECK(cs.end == map(first_rw) + first_rw.size / 4);
+   emit(&cs, tu_cs_get_space(&cs), 0x55555555);
+   emit(&cs, 1, 0x66666666);
+   CHECK(cs.read_write.count == 2);
+   tu_cs_set_writeable(&cs, false);
+   tu_cs_end(&cs);
+   for (unsigned i = 0; i < cs.entry_count; ++i)
+      check_entry(cs.entries[i], cs);
+
+   const auto retained_ro = last(cs.read_only);
+   const auto retained_rw = last(cs.read_write);
+   const uint64_t maps_before_reset = counters().maps;
+   tu_cs_reset(&cs);
+   CHECK(cs.entry_count == 0 && cs.read_only.count == 1 && cs.read_write.count == 1);
+   check_same(last(cs.read_only), retained_ro);
+   check_same(last(cs.read_write), retained_rw);
+   CHECK(cs.start == map(retained_ro) && cs.cur == cs.start);
+   CHECK(cs.end == cs.start + retained_ro.size / 4);
+   CHECK(tu_cs_get_cur_iova(&cs) == retained_ro.bo->iova + retained_ro.offset);
+   check_fill(neighbor, 0xdeadbeef);
+   tu_cs_begin(&cs);
+   emit(&cs, retained_ro.size / 4, 0x77777777);
+   tu_cs_set_writeable(&cs, true);
+   CHECK(cs.start == map(retained_rw));
+   CHECK(cs.end == cs.start + retained_rw.size / 4);
+   emit(&cs, retained_rw.size / 4, 0x88888888);
+   tu_cs_set_writeable(&cs, false);
+   tu_cs_end(&cs);
+   check_fill(neighbor, 0xdeadbeef);
+   CHECK(counters().maps == maps_before_reset);
+   tu_cs_finish(&cs);
+   check_fill(neighbor, 0xdeadbeef);
+   tu_cs_pool_free(f.dev.get(), &neighbor);
+}
