+void
+test_borrowed_entries_and_ib_addresses()
+{
+   fixture f;
+   struct tu_cs a, b, borrowed, caller;
+   for (auto *cs : {&a, &b}) {
+      tu_cs_init(cs, f.dev.get(), TU_CS_MODE_GROW, 16, "secondary draw cs");
+      tu_cs_begin(cs);
+      emit(cs, 4, cs == &a ? 0xaaaaaaaa : 0xbbbbbbbb);
+      tu_cs_end(cs);
+   }
+   CHECK(a.entries[0].bo == b.entries[0].bo);
+   CHECK(a.entries[0].offset != b.entries[0].offset);
+   const int32_t refs = p_atomic_read(&a.entries[0].bo->refcnt);
+   tu_cs_init(&borrowed, f.dev.get(), TU_CS_MODE_GROW, 16, "primary entry list");
+   CHECK(tu_cs_add_entries(&borrowed, &a) == VK_SUCCESS);
+   CHECK(tu_cs_add_entries(&borrowed, &b) == VK_SUCCESS);
+   CHECK(tu_cs_add_entries(&borrowed, &a) == VK_SUCCESS);
+   CHECK(borrowed.entry_count == 3 && !borrowed.read_only.count);
+   CHECK(p_atomic_read(&a.entries[0].bo->refcnt) == refs);
+   tu_cs_init(&caller, f.dev.get(), TU_CS_MODE_GROW, 64, "IB caller cs");
+   tu_cs_begin(&caller);
+   CHECK(tu_cs_get_call_size(&borrowed) == 12);
+   tu_cs_emit_call(&caller, &borrowed);
+   tu_cs_end(&caller);
+   CHECK(caller.entry_count == 1 && caller.entries[0].size == 12 * 4);
+   auto *packets = reinterpret_cast<uint32_t *>(static_cast<char *>(caller.entries[0].bo->map) +
+                                               caller.entries[0].offset);
+   for (unsigned i = 0; i < borrowed.entry_count; ++i) {
+      const auto &entry = borrowed.entries[i];
+      CHECK(packets[4 * i] == pm4_pkt7_hdr(CP_INDIRECT_BUFFER, 3));
+      const uint64_t address = uint64_t(packets[4 * i + 1]) | (uint64_t(packets[4 * i + 2]) << 32);
+      CHECK(address == entry.bo->iova + entry.offset);
+      CHECK(packets[4 * i + 3] == entry.size / 4);
+      check_entry(entry, i == 1 ? b : a);
+   }
+   /* Borrowing is intentionally not made owning. Both secondaries stay alive
+    * until all borrowed entry use above is complete, as Vulkan requires.
+    */
+   tu_cs_finish(&borrowed);
+   CHECK(cs_test::is_live(a.entries[0].bo));
+   CHECK(p_atomic_read(&a.entries[0].bo->refcnt) >= refs);
+   CHECK(*reinterpret_cast<uint32_t *>(static_cast<char *>(b.entries[0].bo->map) +
+                                      b.entries[0].offset) == 0xbbbbbbbb);
+   tu_cs_finish(&caller);
+   tu_cs_finish(&b);
+   tu_cs_finish(&a);
+}
