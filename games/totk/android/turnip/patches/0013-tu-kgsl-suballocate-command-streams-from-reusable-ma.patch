+void
+test_substreams_and_alignment()
+{
+   fixture f;
+   struct tu_cs_allocation neighbor;
+   CHECK(tu_cs_pool_alloc(f.dev.get(), page, false, "alignment neighbor", &neighbor) == VK_SUCCESS);
+   fill(neighbor, 0xfeedface);
+   struct tu_cs cs, sub;
+   tu_cs_init(&cs, f.dev.get(), TU_CS_MODE_SUB_STREAM, 16, "aligned sub cs");
+   struct tu_cs_memory zero;
+   CHECK(tu_cs_alloc(&cs, 0, 4, &zero) == VK_SUCCESS && !zero.map);
+   CHECK(counters().maps == 1 && cs.read_only.count == 0);
+
+   /* A new slice starts at page 1, not offset zero. Three-dword alignment must
+    * account for this origin and for padding when growth is required.
+    */
+   CHECK(tu_cs_begin_sub_stream_aligned(&cs, 2, 3, &sub) == VK_SUCCESS);
+   CHECK(last(cs.read_only).offset != 0);
+   emit(&sub, 6, 0xa1234567);
+   auto entry = tu_cs_end_sub_stream(&cs, &sub);
+   CHECK(entry.offset / 4 % 3 == 0 && entry.size == 24);
+   CHECK(sub.external_iova == entry.bo->iova + entry.offset);
+   check_entry(entry, cs);
+   const uint32_t old_count = cs.read_only.count;
+   CHECK(tu_cs_begin_sub_stream_aligned(&cs, 32, 3, &sub) == VK_SUCCESS);
+   emit(&sub, 96, 0xb1234567);
+   entry = tu_cs_end_sub_stream(&cs, &sub);
+   CHECK(cs.read_only.count > old_count);
+   CHECK(entry.offset / 4 % 3 == 0 && entry.size == 96 * 4);
+   check_entry(entry, cs);
+
+   for (unsigned size : {1u, 4u, 16u, 1024u}) {
+      struct tu_cs_memory memory;
+      CHECK(tu_cs_alloc(&cs, 3, size, &memory) == VK_SUCCESS);
+      const auto &allocation = last(cs.read_only);
+      CHECK(memory.iova % (size * 4) == 0);
+      CHECK(memory.map >= map(allocation));
+      CHECK(memory.map + 3 * size <= map(allocation) + allocation.size / 4);
+      std::fill_n(memory.map, 3 * size, size);
+   }
+   tu_cs_set_writeable(&cs, true);
+   CHECK(tu_cs_begin_sub_stream_aligned(&cs, 2, 16, &sub) == VK_SUCCESS);
+   emit(&sub, 8, 0xc1234567);
+   const auto state = tu_cs_end_draw_state(&cs, &sub);
+   CHECK(state.writeable && state.size == 8);
+   CHECK(state.iova % 64 == 0);
+   tu_cs_set_writeable(&cs, false);
+   const auto ro = last(cs.read_only);
+   const auto rw = last(cs.read_write);
+   tu_cs_reset(&cs);
+   check_same(last(cs.read_only), ro);
+   check_same(last(cs.read_write), rw);
+   CHECK(cs.start == map(ro) && cs.end == map(ro) + ro.size / 4);
+   struct tu_cs draw;
+   auto draw_state = tu_cs_draw_state(&cs, &draw, 8);
+   CHECK(draw_state.size == 8 && !draw_state.writeable);
+   emit(&draw, 8, 0xd1234567);
+   tu_cs_end(&draw);
+   tu_cs_finish(&draw);
+   check_fill(neighbor, 0xfeedface);
+   tu_cs_finish(&cs);
+   tu_cs_pool_free(f.dev.get(), &neighbor);
+}
