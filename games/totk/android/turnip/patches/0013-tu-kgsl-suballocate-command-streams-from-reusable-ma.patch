+void
+test_empty_cache_and_partial_parent_lifetime()
+{
+   fixture f;
+   for (bool writeable : {false, true}) {
+      std::vector<struct tu_cs_allocation> allocations(4 * slab_size / page);
+      for (auto &allocation : allocations)
+         CHECK(tu_cs_pool_alloc(f.dev.get(), page, writeable, "cache cs", &allocation) == VK_SUCCESS);
+      const unsigned per_slab = slab_size / page;
+      std::vector<struct tu_cs_allocation> pinned;
+      std::set<struct tu_bo *> parents;
+      for (unsigned i = 0; i < allocations.size(); ++i) {
+         if (parents.insert(allocations[i].bo).second) {
+            pinned.push_back(allocations[i]);
+            fill(pinned.back(), 0xfacefeed);
+         } else {
+            tu_cs_pool_free(f.dev.get(), &allocations[i]);
+         }
+      }
+      CHECK(pinned.size() == 4 && allocations.size() == 4 * per_slab);
+      CHECK(counters().live == (writeable ? 5 : 4));
+      for (auto &allocation : pinned) {
+         check_fill(allocation, 0xfacefeed);
+         tu_cs_pool_free(f.dev.get(), &allocation);
+      }
+      CHECK(counters().live == (writeable ? 2 : 1));
+   }
+}
